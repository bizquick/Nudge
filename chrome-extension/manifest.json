{
  "manifest_version": 3,
  "name": "Addly",
  "short_name": "Addly",
  "version": "1.1.0",
  "description": "Send any page to friends on Addly, and check the nudges waiting for you. Because \"I'll check it out later\" is a lie.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Send with Addly",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://eygojfpgisswyndusron.supabase.co/*"
  ]
}