// Cloudflare settings for the flagem.app website (the pages in site/).
// Publish updates with:  npx wrangler deploy --config site.wrangler.jsonc
// The old nudgem.app address forwards here (see site-worker.js).
{
  "name": "nudgem-site",
  "main": "./site-worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "flagem.app", "custom_domain": true },
    { "pattern": "www.flagem.app", "custom_domain": true },
    { "pattern": "nudgem.app", "custom_domain": true },
    { "pattern": "www.nudgem.app", "custom_domain": true }
  ]
}
